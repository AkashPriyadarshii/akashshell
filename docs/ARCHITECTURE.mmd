flowchart TD
    subgraph UI ["Win32 Modern GUI Window (UI Thread)"]
        WND[DWM Dark Window - Mica Backdrop]
        HEADER[Status Strip - CWD & State Indicator]
        OUTPUT[Terminal Viewport - Cascadia Code Monospace]
        INPUT[Command Bar - History Recall Up/Down]
    end

    subgraph WORKER ["Asynchronous Execution Engine (Worker Thread)"]
        PARSE[Pipe Splitter]
        BUILTINS{cd / exit?}
        EXEC_PIPE[CreateProcess Chain - cmd /c]
        READER[Anonymous Pipe Stream Reader]
    end

    subgraph PERSISTENCE ["File System"]
        HIST_FILE[("%USERPROFILE%\.akashshell_history")]
    end

    INPUT -->|Enter / Exec| WORKER
    INPUT <-->|Up / Down Arrow| HIST_FILE
    BUILTINS -->|cd| HEADER
    BUILTINS -->|exit| HIST_FILE
    EXEC_PIPE --> READER
    READER -->|PostMessageA WM_USER+1| OUTPUT
